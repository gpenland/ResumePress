generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                     @id @default(cuid())
  name                       String?
  email                      String?                    @unique
  emailVerified              DateTime?
  image                      String?
  accounts                   Account[]
  sessions                   Session[]
  entries                    Entry[]
  resumes                    Resume[]
  categories                 Category[]
  apiTokens                  ApiToken[]
  companies                  Company[]
  applications               Application[]
  applicationStatusHistories ApplicationStatusHistory[]
  contacts                   Contact[]
  applicationContacts        ApplicationContact[]
  interactions               Interaction[]
  emailThreads               EmailThread[]
  gmailAccount               GmailAccount?
  entryVersions              EntryVersion[]
  resumeSnapshots            ResumeSnapshot[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String
  isBuiltIn Boolean @default(false)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@unique([userId, slug])
}

model Entry {
  id            String         @id @default(cuid())
  title         String // the text rendered into the PDF export
  displayTitle  String? // optional display-name override shown only in the ResumePress UI; has no effect on the PDF export
  organization  String?
  location      String?
  startDate     String?
  endDate       String?
  description   String?
  bullets       String[]
  url           String?
  tags          String[]
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeEntries ResumeEntry[]
  versions      EntryVersion[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// One row per edit, written automatically by updateEntryForUser before it
// applies the new values — see "Entry version history" in CLAUDE.md. `data`
// is a frozen snapshot of the Entry's own editable fields immediately
// *before* the edit that created this row (the live Entry row is always the
// current version; this table only ever holds past ones).
model EntryVersion {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  data      Json
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Resume {
  id           String           @id @default(cuid())
  name         String
  templateId   String           @default("jake")
  entries      ResumeEntry[]
  identity     Json?
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  snapshots    ResumeSnapshot[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// A frozen copy of a Resume's rendered content (identity + ordered,
// fully-inlined entry content — not live Entry references), created each
// time a resume is attached to an Application. GitHub issue #26: an
// Application's attached resume must stay what it was *at attach time*,
// not silently change if the underlying Resume's entries are edited later.
// `resumeId` is kept for traceability but is nullable/SetNull — the
// snapshot's own `identity`/`entries` are self-contained and don't need the
// source Resume to still exist to be re-compiled to PDF.
model ResumeSnapshot {
  id           String        @id @default(cuid())
  resumeId     String?
  resume       Resume?       @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  name         String
  templateId   String
  identity     Json?
  entries      Json // EntriesByCategory-shaped: [{ categorySlug, categoryName, entries: EntryLike[] }]
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  createdAt    DateTime      @default(now())
}

model ResumeEntry {
  resumeId String
  entryId  String
  order    Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([resumeId, entryId])
}

model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// --- Applications tracker (added in the ResumePress + Applications merge) ---

model Company {
  id           String        @id @default(cuid())
  name         String
  website      String?
  tier         String? // free-form priority label (e.g. "Target", "Reach", "Safety"); not an enum, kept configurable like Application.status
  notes        String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  contacts     Contact[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Application {
  id               String                     @id @default(cuid())
  companyId        String
  company          Company                    @relation(fields: [companyId], references: [id])
  roleTitle        String
  term             String? // e.g. "Summer 2027"
  status           String                     @default("Applied") // free-form, not an enum — see PLAN.md "keep statuses configurable"
  appliedAt        DateTime?
  postingUrl       String?
  location         String?
  source           String?
  resumeId         String?
  resume           Resume?                    @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeSnapshotId String? // the frozen version attached at attach-time — see ResumeSnapshot
  resumeSnapshot   ResumeSnapshot?            @relation(fields: [resumeSnapshotId], references: [id], onDelete: SetNull)
  notes            String? // markdown
  externalId       String? // set by the CSV/Notion importer so re-imports are idempotent; not used elsewhere
  userId           String
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistory    ApplicationStatusHistory[]
  contacts         ApplicationContact[]
  interactions     Interaction[]
  emailThreads     EmailThread[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([userId, status])
  @@index([userId, updatedAt])
}

// One row per status change, written automatically by the server action that
// updates Application.status (same transaction), plus user-authored rows: a
// note added/edited on an existing entry after the fact, or a manual
// "log update" entry with the same from/to status and just a note (GitHub
// issue #17 — covers things like "2nd interview scheduled" without adding a
// custom status).
model ApplicationStatusHistory {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  note          String?
  changedAt     DateTime    @default(now())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id                  String               @id @default(cuid())
  name                String
  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title               String?
  emails              String[]
  linkedinUrl         String?
  phone               String?
  howMet              String? // career fair, referral, cold outreach, event name, etc. — free-form
  metAt               DateTime?
  notes               String? // markdown
  tags                String[]
  nextFollowUpAt      DateTime?
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications        ApplicationContact[]
  interactions        Interaction[]
  matchedEmailThreads EmailThread[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId, updatedAt])
}

model ApplicationContact {
  applicationId String
  contactId     String
  role          String // recruiter, referrer, hiring manager, other — free-form
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([applicationId, contactId])
}

model Interaction {
  id            String       @id @default(cuid())
  type          String // email, call, meeting, career_fair, coffee_chat, linkedin, other — free-form
  occurredAt    DateTime
  summary       String
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  emailThreadId String?
  emailThread   EmailThread? @relation(fields: [emailThreadId], references: [id], onDelete: SetNull)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([applicationId, occurredAt])
  @@index([contactId, occurredAt])
}

model EmailThread {
  id                   String        @id @default(cuid())
  gmailThreadId        String
  subject              String?
  snippet              String?
  participants         String[]
  lastMessageAt        DateTime?
  gmailUrl             String?
  matchedContactId     String?
  matchedContact       Contact?      @relation(fields: [matchedContactId], references: [id], onDelete: SetNull)
  matchedApplicationId String?
  matchStatus          String        @default("unmatched") // auto, confirmed, unmatched, ignored
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions         Interaction[]
  matchedApplication   Application?  @relation(fields: [matchedApplicationId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Jev-derived triage suggestions, written eagerly by syncGmailForUser for
  // threads not already exactly matched (see "Gmail sync" in CLAUDE.md).
  // Suggestion-only, same as every other Jev feature: Confirm/Ignore/Attach
  // in the triage UI are the only things that ever write matchedContactId/
  // matchedApplicationId/status. Plain nullable columns rather than FK
  // relations on purpose — a stale suggestion pointing at a since-deleted
  // row is harmless noise the UI just stops rendering, not a constraint to
  // enforce.
  jevRecruitingLikely         Boolean?
  jevRecruitingConfidence     Float?
  jevSuggestedContactId       String?
  jevSuggestedContactConf     Float?
  jevSuggestedApplicationId   String?
  jevSuggestedApplicationConf Float?
  jevSuggestedNewCompany      String? // set when recruiting-likely but no existing application looked right
  jevSuggestedNewRole         String?
  jevSuggestedStatus          String? // candidate next status for jevSuggestedApplicationId/matchedApplicationId
  jevSuggestedStatusConf      Float?
  jevClassifiedAt             DateTime?

  // True when this thread currently carries the user's manual override
  // label (GmailAccount.syncLabelIds) — recomputed fresh each sync (set
  // false again if the label's removed in Gmail). A label-forced thread is
  // always eligible for triage regardless of jevRecruitingLikely: see
  // listTriageThreadsForUser's filter and "Gmail sync" in CLAUDE.md.
  labelForced Boolean @default(false)

  @@unique([userId, gmailThreadId])
  @@index([userId, matchStatus])
  @@index([userId, lastMessageAt])
}

// Gmail OAuth grant, fully decoupled from Auth.js's own Account model — see
// docs/MIGRATION_PLAN.md §1.1 for why. Absence of this row (no connected
// Gmail account) must never be required by any other feature: PLAN.md
// principle 1 ("Applications work without contacts") extends to "everything
// works without Gmail" too.
model GmailAccount {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                 String // the connected Gmail address, for display
  encryptedRefreshToken String    @db.Text
  scopes                String[]
  syncLabelIds          String[]  @default([]) // Gmail label ids the user chose to sync (Phase 2C)
  historyId             String?
  lastSyncAt            DateTime?
  connectedAt           DateTime  @default(now())

  // Background-sync tracking (see "Gmail sync" in CLAUDE.md): a sync can
  // run for minutes, far longer than a single request/response is expected
  // to survive, so the browser's "Sync now" kicks it off and polls this
  // instead of awaiting one long-lived call. syncStatus: idle | running |
  // error. syncTotal/syncDone are written by syncGmailForUser's progress
  // callback as it goes — both null until a sync has started at least once.
  syncStatus    String    @default("idle")
  syncStartedAt DateTime?
  syncTotal     Int?
  syncDone      Int?
  syncError     String?
}
