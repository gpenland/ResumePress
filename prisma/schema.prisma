generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  entries       Entry[]
  resumes       Resume[]
  categories    Category[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String
  isBuiltIn Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@unique([userId, slug])
}

model Entry {
  id            String        @id @default(cuid())
  title         String // internal/ResumePress-facing label, shown in lists
  pdfTitle      String? // text rendered on the PDF; null falls back to `title`
  organization  String?
  location      String?
  startDate     String?
  endDate       String?
  description   String?
  bullets       String[]
  url           String?
  tags          String[]
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeEntries ResumeEntry[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Resume {
  id         String        @id @default(cuid())
  name       String
  templateId String        @default("jake")
  entries    ResumeEntry[]
  identity   Json?
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ResumeEntry {
  resumeId String
  entryId  String
  order    Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([resumeId, entryId])
}
