DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumepress?schema=public"
AUTH_SECRET=""      # generate with: npx auth secret
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Allowlist (whole app, see docs/MIGRATION_PLAN.md §1.2) — comma-separated list
# of the only Google account emails permitted to sign in. Pairs with (doesn't
# replace) restricting the Google Cloud OAuth consent screen's own Test users
# list.
ALLOWED_EMAILS=""

# AES-256-GCM key for encrypting the Gmail refresh token at rest (separate from
# AUTH_SECRET, see docs/MIGRATION_PLAN.md §1.1). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=""

# TypeSafe AI (Jev) API key for AI-assisted scoring/matching features.
# https://console.typesafe.ai/keys
TYPESAFE_API_KEY=""
