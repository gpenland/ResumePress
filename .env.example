DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumepress?schema=public"
AUTH_SECRET=""      # generate with: npx auth secret
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Single-owner allowlist (whole app, see docs/MIGRATION_PLAN.md §1.2) — the only
# Google account email permitted to sign in.
OWNER_EMAIL=""

# AES-256-GCM key for encrypting the Gmail refresh token at rest (separate from
# AUTH_SECRET, see docs/MIGRATION_PLAN.md §1.1). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=""
